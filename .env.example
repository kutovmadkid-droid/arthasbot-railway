# Configure these in Railway Variables; this file is NOT loaded automatically.
BOT_TOKEN=
ADMIN_IDS=
DATA_DIR=/data
# Set true in Railway to activate the requested manual crypto module.
# Then enable checkout in /admin after configuring products, terms and wallet.
# Telegram requires Stars for in-app digital goods; this switch is NOT an exemption.
# Safe default stays false until the owner explicitly configures checkout.
ALLOW_MANUAL_CRYPTO_CHECKOUT=false
PORT=8080
